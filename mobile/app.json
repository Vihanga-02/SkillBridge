{
  "expo": {
    "name": "SkillBridge",
    "slug": "skillbridge",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "skillbridge",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.skillbridge.app"
    },
    "android": {
      "package": "com.skillbridge.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4F1",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-logo.png",
          "imageWidth": 300,
          "resizeMode": "contain",
          "backgroundColor": "#F6F7F9"
        }
      ],
      "expo-video",
      [
        "expo-image-picker",
        {
          "photosPermission": "SkillBridge needs access to your photos so you can set a profile picture, attach certificates, and share images in chats or posts.",
          "cameraPermission": "SkillBridge needs camera access so you can photograph a certificate."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
