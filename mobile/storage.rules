rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function userRole() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role;
    }

    function isTeacher() {
      return signedIn() && (userRole() == 'teacher' || userRole() == 'both');
    }

    function ownsLesson(teacherId, lessonId) {
      return signedIn()
        && teacherId == request.auth.uid
        && firestore.get(/databases/(default)/documents/lessons/$(lessonId)).data.teacherId == request.auth.uid;
    }

    function isEnrolled(lessonId) {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/enrollments/$(request.auth.uid + '_' + lessonId));
    }

    match /lesson-files/{teacherId}/{lessonFolder}/{fileName} {
      // Legacy objects use lessonFolder == lessonId. New readable objects carry
      // the canonical lesson ID as immutable custom metadata.
      allow read: if ownsLesson(teacherId, lessonFolder)
        || isEnrolled(lessonFolder)
        || ('lessonId' in resource.metadata
          && (ownsLesson(teacherId, resource.metadata.lessonId)
            || isEnrolled(resource.metadata.lessonId)));
      allow create, update: if isTeacher()
        && teacherId == request.auth.uid
        && 'lessonId' in request.resource.metadata
        && ownsLesson(teacherId, request.resource.metadata.lessonId)
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
      allow delete: if isTeacher()
        && teacherId == request.auth.uid
        && (ownsLesson(teacherId, lessonFolder)
          || ('lessonId' in resource.metadata
            && ownsLesson(teacherId, resource.metadata.lessonId)));
    }

    match /credentials/{uid}/{fileName} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn() && uid == request.auth.uid;
    }

    match /avatars/{fileName} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn()
        && fileName == request.auth.uid + '.jpg'
        && request.resource.size <= 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
